# Esta es la plantilla de las variables de entorno.
#
# La idea es que cada uno copie este archivo como .env y lo ajuste si necesita:
#
#   copy .env.example .env
#
# El .env no se sube al repositorio porque ahí van las credenciales. Este sí se
# sube, para que todos sepan qué variables existen.
#
# Si van a trabajar con Docker no necesitan tocar nada de acá. El compose
# define sus propias variables y esas mandan. Esto es para cuando corren el
# proyecto directo en su máquina con el entorno virtual y el runserver.

# Qué configuración usa Django. Las opciones son config.settings.local para
# desarrollo, config.settings.test para los tests y config.settings.production
# para el servidor.
DJANGO_SETTINGS_MODULE=config.settings.local

# Firma las cookies de sesión y los tokens CSRF. En desarrollo da lo mismo el
# valor, fuera de tu máquina tiene que ser larga y aleatoria.
SECRET_KEY=cambiar-esto-en-cada-entorno

# En True muestra el detalle de los errores en el navegador, que es cómodo para
# desarrollar. Nunca en True fuera de tu máquina, porque deja ver la
# configuración completa del proyecto.
DEBUG=True

# Desde qué dominios Django acepta peticiones, separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos

DB_ENGINE=django.db.backends.mysql
DB_NAME=portal_edocere
DB_USER=portal
DB_PASSWORD=portal

# 127.0.0.1 sirve para dos casos: si instalaron MariaDB en su máquina, o si
# levantan solo la base con "docker compose up mariadb" y corren Django afuera.
#
# Cuando el portal corre adentro de Docker este valor no se usa, porque el
# compose lo reemplaza por "mariadb".
DB_HOST=127.0.0.1
DB_PORT=3306

# Otros

# Cuánto detalle muestran los logs: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
